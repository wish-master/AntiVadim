{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "antivadim",
  "version": "0.1.0",
  "identifier": "org.github.wish-master.antivadim",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AntiVadim",
        "fullscreen": false,
        "resizable": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
